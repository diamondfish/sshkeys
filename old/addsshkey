set -e

VERSION="1.1.0"
REPO_URL="https://raw.githubusercontent.com/diamondfish/addsshkey/master/addsshkey"
APP_NAME="addsshkey"
INSTALL_PATH="/usr/local/bin/$APP_NAME"

show_usage() {
  echo "Usage: $APP_NAME [options] <key>"
  echo "Add an SSH public key to the authorized_keys file."
  echo ""
  echo "Arguments:"
  echo "  key             The SSH public key to add (e.g., 'ssh-rsa AAAA... user@host')"
  echo ""
  echo "Options:"
  echo "  -u, --user      Specify target user (default: current user)"
  echo "  -v, --version   Show version number."
  echo "  -h, --help      Show this help message."
  echo "  --update        Update $APP_NAME to the latest version."
  echo ""
  echo "Examples:"
  echo "  $APP_NAME 'ssh-rsa AAAA... user@host'"
  echo "  $APP_NAME -u www-data 'ssh-ed25519 AAAA... user@host'"
  exit 0
}

show_version() {
  echo "$APP_NAME version $VERSION"
  echo "Copyright © 2025 Johan Bjarnle"
  echo "License: MIT"
  exit 0
}

self_update() {
  echo "Updating $APP_NAME..."
  if [ ! -w "$(dirname "$INSTALL_PATH")" ]; then
    echo "You need sudo privileges to update $APP_NAME."
    sudo curl -fsSL "$REPO_URL" -o "$INSTALL_PATH"
    sudo chmod +x "$INSTALL_PATH"
  else
    curl -fsSL "$REPO_URL" -o "$INSTALL_PATH"
    chmod +x "$INSTALL_PATH"
  fi
  echo "$APP_NAME updated successfully!"
  "$INSTALL_PATH" --version
  exit 0
}

# Extract key type and key data (without comment) from a full SSH key line
# Returns: "key_type key_data" (without the comment part)
extract_key_signature() {
  local full_key="$1"
  # SSH key format: type base64data [comment]
  # We only want type and base64data for comparison
  echo "$full_key" | awk '{print $1, $2}'
}

# Check if a key already exists in authorized_keys (ignoring comments)
key_exists() {
  local key_signature="$1"
  local auth_keys_file="$2"

  if [ ! -f "$auth_keys_file" ]; then
    return 1
  fi

  # Read each non-comment line and compare key signatures
  while IFS= read -r line || [ -n "$line" ]; do
    # Skip empty lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    local existing_signature
    existing_signature=$(extract_key_signature "$line")

    if [ "$existing_signature" = "$key_signature" ]; then
      return 0
    fi
  done < "$auth_keys_file"

  return 1
}

# Get home directory for a user
get_user_home() {
  local username="$1"
  getent passwd "$username" | cut -d: -f6
}

# Check if user exists
user_exists() {
  local username="$1"
  id "$username" &>/dev/null
}

# Set default values
key=""
target_user=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_usage
      ;;
    -v|--version)
      show_version
      ;;
    --update)
      self_update
      ;;
    -u|--user)
      if [[ -z "$2" || "$2" == -* ]]; then
        echo "Error: -u/--user requires a username argument."
        exit 1
      fi
      target_user="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1"
      show_usage
      ;;
    *)
      key="$1"
      shift
      ;;
  esac
done

# Validate that a key was provided
if [ -z "$key" ]; then
  echo "Error: No SSH key provided."
  echo ""
  show_usage
fi

# Validate key format (basic check: should have at least 2 parts)
key_parts=($key)
if [ ${#key_parts[@]} -lt 2 ]; then
  echo "Error: Invalid SSH key format."
  echo "Expected format: ssh-rsa|ssh-ed25519|... <base64-key> [comment]"
  exit 1
fi

# Validate key type
key_type="${key_parts[0]}"
valid_types=("ssh-rsa" "ssh-dss" "ssh-ed25519" "ssh-ed448" "ecdsa-sha2-nistp256" "ecdsa-sha2-nistp384" "ecdsa-sha2-nistp521" "sk-ssh-ed25519@openssh.com" "sk-ecdsa-sha2-nistp256@openssh.com")
type_valid=false
for valid_type in "${valid_types[@]}"; do
  if [ "$key_type" = "$valid_type" ]; then
    type_valid=true
    break
  fi
done

if [ "$type_valid" = false ]; then
  echo "Error: Unrecognized SSH key type: $key_type"
  echo "Supported types: ${valid_types[*]}"
  exit 1
fi

# Determine target user and home directory
if [ -z "$target_user" ]; then
  target_user="$USER"
  target_home="$HOME"
else
  # Check if user exists
  if ! user_exists "$target_user"; then
    echo "Error: User '$target_user' does not exist."
    exit 1
  fi
  target_home=$(get_user_home "$target_user")
  if [ -z "$target_home" ]; then
    echo "Error: Could not determine home directory for user '$target_user'."
    exit 1
  fi
fi

# Define paths
ssh_dir="$target_home/.ssh"
auth_keys_file="$ssh_dir/authorized_keys"

# Extract key signature (type + key data, without comment)
key_signature=$(extract_key_signature "$key")

# Check if key already exists
if key_exists "$key_signature" "$auth_keys_file"; then
  echo "Key already exists in $auth_keys_file"
  echo "No changes made."
  exit 0
fi

# Determine if we need sudo (when adding key for another user)
needs_sudo=false
if [ "$target_user" != "$USER" ]; then
  needs_sudo=true
fi

# Create .ssh directory if it doesn't exist
if [ ! -d "$ssh_dir" ]; then
  echo "Creating $ssh_dir..."
  if [ "$needs_sudo" = true ]; then
    sudo mkdir -p "$ssh_dir"
    sudo chown "$target_user:$target_user" "$ssh_dir"
    sudo chmod 700 "$ssh_dir"
  else
    mkdir -p "$ssh_dir"
    chmod 700 "$ssh_dir"
  fi
fi

# Create authorized_keys if it doesn't exist
if [ ! -f "$auth_keys_file" ]; then
  echo "Creating $auth_keys_file..."
  if [ "$needs_sudo" = true ]; then
    sudo touch "$auth_keys_file"
    sudo chown "$target_user:$target_user" "$auth_keys_file"
    sudo chmod 600 "$auth_keys_file"
  else
    touch "$auth_keys_file"
    chmod 600 "$auth_keys_file"
  fi
fi

# Add the key
echo "Adding SSH key to $auth_keys_file..."
if [ "$needs_sudo" = true ]; then
  echo "$key" | sudo tee -a "$auth_keys_file" > /dev/null
else
  echo "$key" >> "$auth_keys_file"
fi

echo "SSH key added successfully for user '$target_user'."


